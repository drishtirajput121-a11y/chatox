web: python -c "import os, psycopg2; conn = psycopg2.connect(dbname=os.environ.get('DB_NAME'), user=os.environ.get('DB_USER'), password=os.environ.get('DB_PASSWORD'), host=os.environ.get('DB_HOST'), port=os.environ.get('DB_PORT', '5432')); conn.autocommit = True; cur = conn.cursor(); cur.execute('CREATE SCHEMA IF NOT EXISTS chatox'); conn.close(); print('Schema ready')" && python manage.py migrate && daphne -b 0.0.0.0 -p $PORT chatox.asgi:application
worker: celery -A chatox worker --loglevel=info
beat: celery -A chatox beat --loglevel=info